# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PLATFORM_FEE_BPS=500

# App
APP_BASE_URL=http://localhost:3000
APP_VERSION=

# Rate limiting — trusted proxies (KAN-38)
#
# LEAVE BOTH EMPTY ON VERCEL. Vercel overwrites X-Forwarded-For at the edge and
# refuses to forward external IPs precisely to stop spoofing, so the header is
# already authoritative and the limiter reads it directly (detected via VERCEL).
# Listing proxies here does nothing on Vercel: its internal peer address is not
# a stable IP you could enumerate.
#
# Only set these when self-hosting behind your own reverse proxy, e.g. Nginx on
# a VPS: RATE_LIMIT_TRUSTED_PROXIES=127.0.0.1,::1 with 1 hop.
# Empty and not on Vercel = X-Forwarded-For is ignored and the socket peer is used.
# Accepts IPs or CIDRs, IPv4 and IPv6, comma-separated.
RATE_LIMIT_TRUSTED_PROXIES=
RATE_LIMIT_TRUSTED_PROXY_HOPS=1

# Resend (transactional email)
RESEND_API_KEY=
# Must be a sender on a domain VERIFIED in Resend, e.g. "Contest Manager
# <noreply@yourdomain.com>". Resend rejects anything else, and before KAN-63
# that rejection was recorded as a successful send — 16 of the first 21 emails
# never left the provider and every one of them said "sent".
RESEND_FROM=

# Sentry (optional — module auto-disables if SENTRY_DSN empty)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Maintenance endpoints (scheduled purge of inscription uploads, KAN-69).
# Unset means the endpoint refuses every caller — it never falls open.
# Generate with `openssl rand -hex 32`. pg_cron calls the endpoint every 15 min
# (migration 0062) and reads the SAME value from Supabase Vault, so set it in
# both places:
#   select vault.create_secret('<this value>', 'maintenance_secret');
#   select vault.create_secret('https://<production host>', 'maintenance_base_url');
# Check it runs: select * from maintenance_runs order by ran_at desc limit 5;
MAINTENANCE_SECRET=
